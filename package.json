{
  "name": "auricapri",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --fix",
    "lint:report": "mkdir -p ../.lint-reports && eslint \"src/**/*.{js,jsx,ts,tsx}\" -f json -o ../.lint-reports/eslint.auricapri.json",
    "lint:strict": "eslint \"src/**/*.{js,jsx,ts,tsx}\" --max-warnings 0",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:perf": "playwright test --config=playwright.perf.config.ts",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report",
    "test:report:doc": "node scripts/generate-e2e-report.mjs",
    "docs": "playwright test --config=playwright.docs.config.ts",
    "docs:headed": "playwright test --config=playwright.docs.config.ts --headed",
    "docs:full": "playwright test --config=playwright.docs.config.ts tests/full-documentation.spec.ts",
    "docs:full:headed": "playwright test --config=playwright.docs.config.ts tests/full-documentation.spec.ts --headed",
    "docs:complete": "playwright test --config=playwright.docs.config.ts tests/complete-navigation.spec.ts --headed",
    "docs:complete:headless": "playwright test --config=playwright.docs.config.ts tests/complete-navigation.spec.ts",
    "docs:user-flow": "playwright test --config=playwright.docs.config.ts tests/user-flow.spec.ts --headed",
    "docs:all": "playwright test --config=playwright.docs.config.ts --headed",
    "version:update": "node ../scripts/update-version.js --app=auricapri",
    "version:watch": "node ../scripts/version-watcher.js",
    "sitemap:generate": "tsx scripts/generate-sitemap.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "2.39.0",
    "@tanstack/react-query": "^5.90.16",
    "html2canvas": "^1.4.1",
    "lucide-react": "0.462.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-ga4": "^2.1.0",
    "react-helmet-async": "^2.0.6",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-plugin-unused-imports": "^4.2.0",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^3.2.4"
  }
}
