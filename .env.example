# Frontend Environment Variables
# Copy this file to .env or .env.local and fill in the values

# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Frontend URL (IMPORTANT for OAuth)
# In production, set this to your public URL (e.g., https://auricapri.com)
# In development, you can leave empty and it will use window.location.origin
VITE_FRONTEND_URL=http://localhost:3000

# API URL (Backend)
# In development: http://localhost:3001/api
# In production: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:3001/api

# Gemini API Key (Optional - only if using AI features)
GEMINI_API_KEY=your-gemini-api-key-here

# InfinitPay Configuration (Optional)
VITE_USE_INFINITPAY_CHECKOUT=false
