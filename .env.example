# Frontend Environment Variables
# Copy this file to .env or .env.local and fill in the values

# Supabase Configuration (REQUIRED)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Frontend URL (IMPORTANT for OAuth)
# In production, set this to your public URL (e.g., https://auricapri.com)
# In development, you can leave empty and it will use window.location.origin
VITE_FRONTEND_URL=http://localhost:3009

# API URL (Backend)
# In development: http://localhost:3001/api
# In production: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:3001/api

# Gemini API Key (Optional - only if using AI features)
GEMINI_API_KEY=your-gemini-api-key-here

# InfinitPay Configuration (Optional)
VITE_USE_INFINITPAY_CHECKOUT=false

# AI Integrations (Chat & FaceSwap)
# As chamadas de IA agora passam pelo backend (/api/ai/*)
# O backend adiciona autenticação X-API-Key automaticamente
# Não é necessário configurar URLs de IA no frontend

# Google Analytics 4 (Optional - for SEO and tracking)
# Get your Measurement ID from: Analytics > Admin > Data Streams > Web > Measurement ID
# Format: G-XXXXXXXXXX
VITE_GA4_MEASUREMENT_ID=

# Mapbox (public token for store location map)
VITE_MAPBOX_TOKEN=your-mapbox-public-token

# R2 CDN Public URL (Optional - fallback when Supabase Storage is down)
# This must match the public URL of your Cloudflare R2 bucket
VITE_R2_PUBLIC_URL=https://cdn.auricapri.com.br
