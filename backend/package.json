{
  "name": "auricapri-backend",
  "version": "1.0.0",
  "description": "Backend API for Auricapri ecommerce",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "dev:node": "tsx watch src/server.ts",
    "build": "tsc && cp -r src/config/*.json dist/config/ 2>/dev/null || true && if [ -f dist/src/server.js ]; then cp dist/src/server.js dist/server.js; fi && if [ -d dist/src ]; then cp -r dist/src/* dist/ 2>/dev/null || true; rm -rf dist/src; fi",
    "build:tsc": "tsc",
    "start": "bun dist/server.js",
    "start:node": "node ./dist/server.js",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"shared/**/*.{js,jsx,ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"shared/**/*.{js,jsx,ts,tsx}\" --fix",
    "lint:report": "mkdir -p ../.lint-reports && eslint \"src/**/*.{js,jsx,ts,tsx}\" \"shared/**/*.{js,jsx,ts,tsx}\" -f json -o ../.lint-reports/eslint.backend.json",
    "lint:strict": "eslint \"src/**/*.{js,jsx,ts,tsx}\" \"shared/**/*.{js,jsx,ts,tsx}\" --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "version:update": "node ../scripts/update-version.js --app=backend",
    "version:watch": "node ../scripts/version-watcher.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "@types/express-rate-limit": "^5.1.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.1",
    "multer": "^1.4.5-lts.1",
    "prom-client": "^15.1.3",
    "puppeteer": "^24.35.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.19.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "eslint": "^8.57.1",
    "eslint-plugin-unused-imports": "^4.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.17"
  }
}
